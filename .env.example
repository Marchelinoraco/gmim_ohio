# Copy to .env.local and fill in. .env.local is git-ignored.
# The Neon vars are managed by the Neon CLI — run `neon env pull` (or
# `neon checkout <branch>`) to (re)write DATABASE_URL / DATABASE_URL_UNPOOLED
# for the currently linked branch. See .neon for the linked project/branch.

# --- Neon Postgres (managed by `neon env pull`) ---
# Pooled connection (-pooler host) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct/unpooled connection — used by drizzle-kit migrations, pg_dump, LISTEN/NOTIFY.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Written by neon env pull; informational.
NEON_BRANCH="dev"

# --- better-auth ---
# Random 32+ byte secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Canonical site URL. Local: http://localhost:3000 . Production: the Vercel URL.
BETTER_AUTH_URL="http://localhost:3000"

# --- Vercel Blob (Rencana 3 — file uploads) ---
# From the Vercel project: Storage -> Blob -> .env.local tab. Leave empty until then.
BLOB_READ_WRITE_TOKEN=""

# --- Contact-form email notification (optional; Rencana 2/3) ---
# If unset, contact messages are saved to the DB and shown in the admin inbox only.
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL=""

# --- Seed admin account (used by: pnpm seed:admin) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
