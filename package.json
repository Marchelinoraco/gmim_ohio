    "@tanstack/react-start": "^1.168.49",
    "@vercel/functions": "^3.9.5",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "nitro": "3.0.260610-beta",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.2"
